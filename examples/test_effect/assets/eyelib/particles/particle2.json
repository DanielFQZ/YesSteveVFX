{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "yesstevevfx:test/particle2",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "yesstevevfx:textures/particle"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.limit1 = 0.6;v.size1 = 0.2;v.size2 = 0.4;v.power1 = 4;v.power2 = 2;v.range1 = 1;v.range2 = 2;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 40,
        "max_particles": 100
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "(( variable.particle_random_1<v.limit1 )?( v.range1 ):( v.range2 )) * math.sin(360 * math.mod(variable.particle_random_1*10,1)) * math.sin(180 * math.mod(variable.particle_random_1*100,1))",
          "(( variable.particle_random_1<v.limit1 )?( v.range1 ):( v.range2 )) * math.cos(180 * math.mod(variable.particle_random_1*100,1))",
          "(( variable.particle_random_1<v.limit1 )?( v.range1 ):( v.range2 )) * math.cos(360 * math.mod(variable.particle_random_1*10,1)) * math.sin(180 * math.mod(variable.particle_random_1*100,1))"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(( variable.particle_random_1<v.limit1 )?( math.random(0.4,0.7) ):( math.random(0.6,1) ))"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "(( variable.particle_random_1<v.limit1 )?( 0 ):( 90 ))"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "(( variable.particle_random_1<v.limit1 )?( v.power1 ):( v.power2 )) * math.sin(360 * math.mod(variable.particle_random_1*10,1)) * math.sin(180 * math.mod(variable.particle_random_1*100,1))",
          "(( variable.particle_random_1<v.limit1 )?( v.power1 ):( v.power2 )) * math.cos(180 * math.mod(variable.particle_random_1*100,1))",
          "(( variable.particle_random_1<v.limit1 )?( v.power1 ):( v.power2 )) * math.cos(360 * math.mod(variable.particle_random_1*10,1)) * math.sin(180 * math.mod(variable.particle_random_1*100,1))"
        ],
        "linear_drag_coefficient": 10
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(( variable.particle_random_1<v.limit1 )?( v.size1 ):( v.size2 ))",
          "(( variable.particle_random_1<v.limit1 )?( v.size1 ):( v.size2 ))"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            "(( variable.particle_random_1<v.limit1 )?( 0 ):( 16 ))",
            "(( variable.particle_random_1<v.limit1 )?( math.trunc(variable.particle_age / variable.particle_lifetime * 4) * 16 ):( 0 ))"
          ],
          "uv_size": [
            "(( variable.particle_random_1<v.limit1 )?( 16 ):( 32 ))",
            "(( variable.particle_random_1<v.limit1 )?( 16 ):( 32 ))"
          ]
        }
      }
    }
  }
}
