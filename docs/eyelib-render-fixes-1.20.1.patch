+//? if <1.20.6 {
+package io.github.tt432.eyelib.bridge.particle.adapter;
+
+import com.mojang.blaze3d.vertex.BufferBuilder;
+import com.mojang.blaze3d.vertex.DefaultVertexFormat;
+import com.mojang.blaze3d.vertex.VertexConsumer;
+import com.mojang.blaze3d.vertex.VertexFormat;
+import net.minecraft.client.renderer.LightTexture;
+import org.joml.Vector3f;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+import java.lang.reflect.Method;
+import java.nio.ByteBuffer;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class BedrockParticleRendererTest {
+    @ParameterizedTest
+    @ValueSource(ints = {0xFFFFFFFF, 0xFF00FF00, 0x804080C0, 0x00132644})
+    void preservesColorAndAlphaInMinecraftVertexBuffer(int argb) throws Exception {
+        // 使用 MC 的真实打包路径回读顶点，捕获整数颜色误传给浮点重载造成的溢出。
+        Method vertex = BedrockParticleRenderer.class.getDeclaredMethod("vertex",
+                VertexConsumer.class, Vector3f.class, int.class,
+                float.class, float.class, int.class, Vector3f.class);
+        vertex.setAccessible(true);
+        BufferBuilder buffer = new BufferBuilder(256);
+        buffer.begin(VertexFormat.Mode.QUADS, DefaultVertexFormat.NEW_ENTITY);
+        for (int i = 0; i < 4; i++) {
+            vertex.invoke(null, buffer, new Vector3f(i, 0, 0), argb,
+                    0.25F, 0.75F, LightTexture.FULL_BRIGHT, new Vector3f(0, 0, 1));
+        }
+        BufferBuilder.RenderedBuffer rendered = buffer.end();
+        try {
+            ByteBuffer bytes = rendered.vertexBuffer();
+            for (int i = 0; i < 4; i++) {
+                int colorOffset = i * DefaultVertexFormat.NEW_ENTITY.getVertexSize() + 12;
+                assertEquals((argb >>> 16) & 255, Byte.toUnsignedInt(bytes.get(colorOffset)), "R");
+                assertEquals((argb >>> 8) & 255, Byte.toUnsignedInt(bytes.get(colorOffset + 1)), "G");
+                assertEquals(argb & 255, Byte.toUnsignedInt(bytes.get(colorOffset + 2)), "B");
+                assertEquals((argb >>> 24) & 255, Byte.toUnsignedInt(bytes.get(colorOffset + 3)), "A");
+            }
+        } finally {
+            rendered.release();
+        }
+    }
+}
+//?}
